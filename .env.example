# Copy to `.env` (git-ignored) and fill in. NEVER commit real values.
# Variable names are INSIGHTOS_ + the setting name in upper case.

# Optional: alternative TOML config file (must exist if set).
# INSIGHTOS_CONFIG_FILE=config/default.toml

# INSIGHTOS_RUNS_DIR=runs
# INSIGHTOS_LOG_LEVEL=INFO
# INSIGHTOS_LOG_TO_FILE=true

# LLM provider (pluggable; not finalized). The API key is a secret: set it only in `.env`
# or the real environment.
# INSIGHTOS_LLM_PROVIDER=
# INSIGHTOS_LLM_MODEL=
INSIGHTOS_LLM_API_KEY=
# INSIGHTOS_LLM_TEMPERATURE=0.0

# INSIGHTOS_LLM_MAX_SAMPLES_PER_COLUMN=10
# INSIGHTOS_PRIVACY_MASK_SENSITIVE_VALUES=true
